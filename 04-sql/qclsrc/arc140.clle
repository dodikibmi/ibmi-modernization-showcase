/* ================================================================= */
/* ARC140 - Accounts receivable daily run            (stage 4: SQL) */
/* 1. post payments  2. print aged trial balance                      */
/* Same as ARC110, calls the stage 4 programs ARR240 and ARR340.      */
/*                                                                    */
/* ================================================================= */
             PGM        PARM(&ASOF)
             DCL        VAR(&ASOF)   TYPE(*CHAR) LEN(8)
             DCL        VAR(&CHECK)  TYPE(*CHAR) LEN(10)
             DCL        VAR(&MSG)    TYPE(*CHAR) LEN(80)

             MONMSG     MSGID(CPF0000 MCH0000) EXEC(GOTO CMDLBL(FAILED))

             CHGVAR     VAR(&MSG) VALUE('As-of date' *BCAT &ASOF *BCAT +
                          'is not a valid YYYYMMDD date')
             CVTDAT     DATE(&ASOF) TOVAR(&CHECK) FROMFMT(*YYMD) +
                          TOFMT(*ISO) TOSEP(*NONE)

             CHGVAR     VAR(&MSG) VALUE('AR daily run failed - see job log')
             CALL       PGM(ARR240)
             CALL       PGM(ARR340) PARM(&ASOF)
             RETURN

 FAILED:     SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA(&MSG) +
                          MSGTYPE(*ESCAPE)
             ENDPGM
